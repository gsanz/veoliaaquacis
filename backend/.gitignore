# .gitignore for Node.js / JavaScript projects

# Dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache directories
.cache/
.eslintcache
.parcel-cache/

# Next.js
.next/
out/

# Nuxt.js
dist/
.nuxt/

# Vite
.vite/

# OS files
.DS_Store
Thumbs.db

# IDE / editors
.vscode/
.idea/
*.swp

# Optional: ignore lockfiles if you are building a library (usually NOT recommended)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Misc
*.tgz
*.tar.gz

# If files were already tracked, remove them with:
# git rm -r --cached .
